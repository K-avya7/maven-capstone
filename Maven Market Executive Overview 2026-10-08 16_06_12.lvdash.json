    {
      "name": "6396f067",
      "displayName": "fact_inventory_snapshot",
      "config": {
        "version": "1.1",
        "source": "dbx_maven_market.gold.fact_inventory_snapshot",
        "dimensions": [
          {
            "name": "inventory_day",
            "expr": "CAST(inventory_date AS DATE)",
            "displayName": "Inventory Date"
          },
          {
            "name": "store_id",
            "expr": "store_id",
            "displayName": "Store"
          },
          {
            "name": "product_id",
            "expr": "product_id"
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product"
          },
          {
            "name": "data_region",
            "expr": "data_region",
            "displayName": "Region"
          },
          {
            "name": "alert_status",
            "expr": "CASE WHEN reorder_flag = 1 THEN 'Reorder Needed' ELSE 'OK' END",
            "displayName": "Alert Status"
          }
        ],
        "measures": [
          {
            "name": "stock_on_hand",
            "expr": "SUM(stock_on_hand)",
            "displayName": "Stock on Hand"
          },
          {
            "name": "alert_count",
            "expr": "COUNT(1) FILTER (WHERE reorder_flag = 1)",
            "displayName": "Inventory Alerts"
          },
          {
            "name": "products_at_risk",
            "expr": "COUNT(DISTINCT product_id) FILTER (WHERE reorder_flag = 1)",
            "displayName": "Products at Risk"
          }
        ]
      }
    },
    {
      "name": "7873fc80",
      "displayName": "fact_returns",
      "config": {
