            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a4ef64bb",
      "displayName": "fact_sales",
      "config": {
        "source": "dbx_maven_market.gold.fact_sales",
        "measures": [
          {
            "name": "order_count",
            "expr": "COUNT(DISTINCT source.transaction_id)",
            "displayName": "Orders"
          },
          {
            "name": "units_sold",
            "expr": "SUM(source.quantity)",
            "displayName": "Units Sold"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(source.quantity * products.product_retail_price)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_profit",
            "expr": "SUM(source.quantity * (products.product_retail_price - products.product_cost))",
            "displayName": "Total Profit",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "profit_margin",
            "expr": "SUM(source.quantity * (products.product_retail_price - products.product_cost)) / SUM(source.quantity * products.product_retail_price)",
            "displayName": "Profit Margin",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "monthly_revenue",
            "expr": "SUM(source.quantity * products.product_retail_price)",
            "window": [
              {
                "order": "transaction_month",
                "range": "current",
                "semiadditive": "last"
              }
            ]
          },
          {
            "name": "monthly_revenue_py",
            "expr": "SUM(source.quantity * products.product_retail_price)",
            "window": [
              {
                "order": "transaction_month",
                "range": "current",
                "offset": "-1 year",
                "semiadditive": "last"
              }
            ]
          },
          {
            "name": "yoy_growth",
            "expr": "(MEASURE(monthly_revenue) - MEASURE(monthly_revenue_py)) / MEASURE(monthly_revenue_py)",
            "displayName": "YoY Growth",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "monthly_revenue_pm",
            "expr": "SUM(source.quantity * products.product_retail_price)",
            "window": [
              {
                "order": "transaction_month",
                "range": "current",
                "offset": "-1 month",
                "semiadditive": "last"
              }
            ]
          },
          {
            "name": "weekly_revenue",
            "expr": "SUM(source.quantity * products.product_retail_price)",
            "window": [
              {
                "order": "transaction_week",
                "range": "current",
                "semiadditive": "last"
              }
            ]
          },
          {
            "name": "weekly_revenue_pw",
            "expr": "SUM(source.quantity * products.product_retail_price)",
            "window": [
              {
                "order": "transaction_week",
                "range": "current",
                "offset": "-7 day",
                "semiadditive": "last"
              }
            ]
          },
          {
            "name": "wow_growth",
            "expr": "(MEASURE(weekly_revenue) - MEASURE(weekly_revenue_pw)) / MEASURE(weekly_revenue_pw)",
            "displayName": "WoW Growth",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "mom_growth",
            "expr": "(MEASURE(monthly_revenue) - MEASURE(monthly_revenue_pm)) / MEASURE(monthly_revenue_pm)",
            "displayName": "MoM Growth",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "transaction_day",
            "expr": "CAST(source.transaction_date AS DATE)",
            "displayName": "Transaction Date"
          },
          {
            "name": "transaction_month",
            "expr": "TRUNC(CAST(source.transaction_date AS DATE), 'MONTH')",
            "displayName": "Month"
          },
          {
            "name": "transaction_year",
            "expr": "YEAR(source.transaction_date)",
            "displayName": "Year"
          },
          {
            "name": "transaction_minute",
            "expr": "DATE_TRUNC('MINUTE', source.transaction_date)",
            "displayName": "Minute"
          },
          {
            "name": "data_region",
            "expr": "source.data_region",
            "displayName": "Region"
          },
          {
            "name": "store_id",
            "expr": "source.store_id"
          },
          {
            "name": "product_id",
            "expr": "source.product_id"
          },
          {
            "name": "product_name",
            "expr": "products.product_name",
            "displayName": "Product"
          },
          {
            "name": "product_brand",
            "expr": "products.product_brand",
            "displayName": "Brand"
          },
          {
            "name": "customer_id",
            "expr": "source.customer_id"
          },
          {
            "name": "transaction_week",
            "expr": "DATE_TRUNC('WEEK', CAST(source.transaction_date AS DATE))",
            "displayName": "Week"
          }
        ],
        "joins": [
          {
            "name": "products",
            "source": "dbx_maven_market.gold.dim_products",
            "on": "source.product_id = products.product_id AND products.`__END_AT` IS NULL",
            "cardinality": "many_to_one"
          }
        ]
      }
    },
    {
      "name": "pipeline_health",
      "displayName": "pipeline_health",
      "config": {
        "source": "system.lakeflow.pipeline_update_timeline",
        "measures": [
          {
            "name": "update_count",
            "expr": "COUNT(DISTINCT update_id)",
            "displayName": "Updates"
          },
          {
            "name": "failed_updates",
            "expr": "COUNT(DISTINCT update_id) FILTER (WHERE result_state = 'FAILED')",
            "displayName": "Failed Updates"
          },
          {
            "name": "failure_rate",
            "expr": "COUNT(DISTINCT update_id) FILTER (WHERE result_state = 'FAILED') / COUNT(DISTINCT update_id)",
            "displayName": "Failure Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "filter": "period_start_time >= current_date() - INTERVAL 30 DAYS",
        "version": "1.1",
        "dimensions": [
          {
            "name": "update_day",
            "expr": "CAST(period_start_time AS DATE)",
            "displayName": "Day"
          },
          {
            "name": "pipeline_id",
            "expr": "pipeline_id",
            "displayName": "Pipeline"
          },
          {
            "name": "update_id",
            "expr": "update_id"
          },
          {
            "name": "result_state",
            "expr": "COALESCE(result_state, 'RUNNING')",
            "displayName": "Result"
          },
          {
            "name": "update_type",
            "expr": "update_type",
            "displayName": "Update Type"
          },
          {
            "name": "trigger_type",
            "expr": "trigger_type",
            "displayName": "Trigger"
          },
          {
            "name": "run_as_user_name",
            "expr": "run_as_user_name",
            "displayName": "Run As"
          }
        ]
      }
    },
